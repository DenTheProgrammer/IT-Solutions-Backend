{
  "name": "it-solutions-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend цифровой визитки Дениса Можайского",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "prisma generate && nest build && tsc -p tsconfig.seed.json",
    "format": "prettier --write src prisma/seed test *.json *.ts *.mjs",
    "start": "nest start",
    "prestart": "prisma generate",
    "start:dev": "nest start --watch",
    "prestart:dev": "prisma generate",
    "start:prod": "node dist/main.js",
    "lint": "eslint src prisma/seed test prisma.config.ts eslint.config.mjs --max-warnings=0",
    "prelint": "prisma generate",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run build && prisma db seed",
    "db:reset": "prisma migrate reset --force && npm run db:seed"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.2.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/graphql": "14.2.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dataloader": "2.2.3",
    "dotenv": "18.0.9",
    "graphql": "16.15.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
