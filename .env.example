# Local development: docker compose up -d db, then copy this file to .env.
# These credentials are only for the disposable local compose database.
DATABASE_URL=postgresql://candidate:candidate_dev@localhost:5432/candidate?schema=public
PORT=3000
NODE_ENV=development
PRISMA_LOG_QUERIES=false
DATABASE_POOL_MAX=5
# false (default), loopback, or private (loopback + RFC1918 + IPv6 unique-local).
TRUST_PROXY=false
# Host ports for docker compose (container ports remain 5432/3000).
DB_HOST_PORT=5432
APP_HOST_PORT=3000
# Optional e2e server connection; e2e creates its own database and drops it after.
# TEST_DATABASE_URL=postgresql://candidate:candidate_dev@localhost:5432/candidate
