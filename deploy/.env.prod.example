# Copy to deploy/.env on the VPS. Keep it private (chmod 600).
APP_IMAGE=it-solutions-card:1.0.0
APP_HOST_PORT=3200
POSTGRES_USER=candidate
POSTGRES_DB=candidate
# Replace BOTH occurrences. URL-encode the password only inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://candidate:replace-with-a-long-random-password@db:5432/candidate?schema=public
DATABASE_POOL_MAX=5
